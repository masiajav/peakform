{
  "name": "replaid-lab",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "cross-env NEXT_DIST_DIR=.next-e2e next build",
    "build:verify": "cross-env NEXT_DIST_DIR=.next-verify next build",
    "overlay:build": "npm --prefix apps/replaid-coach-overlay run build",
    "overlay:test": "npm --prefix apps/replaid-coach-overlay test",
    "start": "next start",
    "start:e2e": "cross-env NEXT_DIST_DIR=.next-e2e next start",
    "audit:content": "node scripts/audit-public-content.mjs",
    "lint": "next lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run lint -- --no-cache && npm run test && npm run build:verify && npm run test:e2e"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "@noble/hashes": "2.4.0",
    "@stripe/stripe-js": "^4.1.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.44.2",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "next": "15.5.27",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "resend": "^6.12.2",
    "sharp": "0.35.5",
    "stripe": "^16.2.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "autoprefixer": "^10.0.1",
    "cross-env": "^7.0.3",
    "eslint": "^8",
    "eslint-config-next": "15.5.27",
    "postcss": "8.5.28",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "4.1.11"
  }
}
