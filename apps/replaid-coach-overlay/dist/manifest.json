{
  "manifest_version": 1,
  "type": "WebApp",
  "meta": {
    "name": "Replaid Pick Lab",
    "version": "0.1.0",
    "minimum-overwolf-version": "0.269.0",
    "author": "Replaid Lab",
    "description": "Asistente de picks para Overwatch basado en sinergias, counters y contexto de mapa.",
    "dock_button_title": "Replaid Pick Lab",
    "icon": "icon.png"
  },
  "permissions": ["GameInfo", "Hotkeys"],
  "data": {
    "game_targeting": {
      "type": "dedicated",
      "game_ids": [10844]
    },
    "game_events": [10844],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [10844]
        },
        "start_minimized": true
      }
    ],
    "start_window": "background",
    "windows": {
      "background": {
        "file": "background.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "is_background_page": true,
        "size": {
          "width": 360,
          "height": 220
        }
      },
      "ingame": {
        "file": "overlay.html",
        "transparent": true,
        "resizable": false,
        "show_in_taskbar": false,
        "in_game_only": true,
        "ignore_keyboard_events": true,
        "size": {
          "width": 720,
          "height": 180
        },
        "start_position": {
          "top": 48,
          "left": 24
        }
      },
      "debug": {
        "file": "debug.html",
        "transparent": false,
        "resizable": true,
        "show_in_taskbar": true,
        "size": {
          "width": 1180,
          "height": 820
        }
      }
    },
    "hotkeys": {
      "toggle_overlay": {
        "title": "Mostrar u ocultar recomendaciones de picks",
        "action-type": "custom",
        "default": "Ctrl+Shift+R"
      },
      "open_debug": {
        "title": "Abrir selector de sinergias y counters",
        "action-type": "custom",
        "default": "Ctrl+Shift+D"
      }
    }
  }
}
